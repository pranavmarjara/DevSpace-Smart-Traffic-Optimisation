modules = ["nodejs-20", "python-3.11", "web"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"
packages = ["openssl", "postgresql"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["uv", "run", "gunicorn", "--bind", "0.0.0.0:5000", "main:app"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34439
externalPort = 6000

[[ports]]
localPort = 34593
externalPort = 3000

[[ports]]
localPort = 35155
externalPort = 3002

[[ports]]
localPort = 35977
externalPort = 5173

[[ports]]
localPort = 37629
externalPort = 3003

[[ports]]
localPort = 39445
externalPort = 3001

[[ports]]
localPort = 40391
externalPort = 8000

[[ports]]
localPort = 40427
externalPort = 4200

[[ports]]
localPort = 41483
externalPort = 8008

[[ports]]
localPort = 41683
externalPort = 5000

[[ports]]
localPort = 43291
externalPort = 6800

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run gunicorn --bind 0.0.0.0:5000 --reuse-port --reload main:app"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
integrations = ["javascript_websocket:1.0.0"]
expertMode = true
